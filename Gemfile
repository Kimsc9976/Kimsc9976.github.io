# Gemfile
source "https://rubygems.org"

# >= 4.2.0 이면 CI에서 Jekyll 4.4.x → sass-embedded 1.100+ → Ruby 3.1 빌드 실패
gem "jekyll", "~> 4.2.2"
gem "webrick", "~> 1.7"
gem "jekyll-sitemap"
gem "jekyll-feed"

# Ruby 3.4+ 에서 stdlib 기본 포함에서 제외됨 (Jekyll 및 의존 gem 로드 시 필요)
gem "csv"
gem "base64"
gem "bigdecimal"
